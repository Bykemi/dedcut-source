function renderThemes(){$('#themes').innerHTML=Object.entries(THEMES).map(([k,t])=>'<button data-th="'+k+'" class="'+(k===ACCK?'on':'')+'"><i style="background:linear-gradient(135deg,'+t[1]+','+t[2]+')"></i>'+esc(T('themes.'+k))+'</button>').join('')}
let ACCK='violet';
renderThemes();
