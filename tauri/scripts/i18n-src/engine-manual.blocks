  <div class="sec"><h4>${T('proj.shortcuts')}</h4><div class="keys">
    <kbd>${T('keys.space')}</kbd><span>${T('keys.playPause')}</span><kbd>S</kbd><span>${T('keys.split')}</span><kbd>${T('keys.del')}</kbd><span>${T('keys.delete')}</span><kbd>${T('keys.shiftDel')}</kbd><span>${T('keys.ripple')}</span>
