    <kbd>← →</kbd><span>${T('keys.frame')}</span><kbd>K</kbd><span>${T('keys.keyframe')}</span><kbd>M</kbd><span>${T('keys.marker')}</span>
    <kbd>${T('keys.wheel')}</kbd><span>${T('keys.zoom')}</span><kbd>Ctrl+S</kbd><span>${T('ui.save')}</span><kbd>Ctrl+E</kbd><span>${T('ui.export')}</span>
